{
  "entities": {
    "Repair": {
      "title": "Repair",
      "description": "Equipment repair work order with diagnostic details and timeline",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "serialNo": { "type": "string", "maxLength": 128 },
        "model": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "client": { "type": "string", "maxLength": 256 },
        "receivedDate": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["ກຳລັງສ້ອມແປງ", "ສຳເລັດແລ້ວ", "ລໍຖ້າກວດເຊັກ", "ກຳລັງສຳຫຼວດ"] },
        "problem": { "type": "string", "maxLength": 2048 },
        "cause": { "type": "string", "maxLength": 2048 },
        "solution": { "type": "string", "maxLength": 2048 },
        "assignedTech": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] }
      },
      "required": ["id", "model", "client", "status"]
    },
    "Project": {
      "title": "Project",
      "description": "Field survey and geodetic measurement project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "client": { "type": "string", "maxLength": 256 },
        "progress": { "type": "number" },
        "status": { "type": "string", "enum": ["ກຳລັງສຳຫຼວດ", "ລໍຖ້າການວິເຄາະ", "ສຳເລັດແລ້ວ"] },
        "location": { "type": "string", "maxLength": 256 },
        "coordinatesLat": { "type": "number" },
        "coordinatesLng": { "type": "number" }
      },
      "required": ["id", "title", "client", "status"]
    },
    "CORSStation": {
      "title": "CORSStation",
      "description": "Continuously Operating Reference Station (CORS)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["ເກົ່າ", "ໃໝ່"] },
        "status": { "type": "string", "enum": ["Online", "Offline"] },
        "issue": { "type": "string", "maxLength": 1024 },
        "notes": { "type": "string", "maxLength": 2048 }
      },
      "required": ["id", "name", "type", "status"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Survey equipment assigned to districts across Lao PDR",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "districtCode": { "type": "string", "maxLength": 32 },
        "districtNameLao": { "type": "string", "maxLength": 128 },
        "districtNameEng": { "type": "string", "maxLength": 128 },
        "provinceName": { "type": "string", "maxLength": 128 },
        "model": { "type": "string", "maxLength": 128 },
        "serialNo": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "maxLength": 1024 }
      },
      "required": ["id", "districtCode", "districtNameLao", "model"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Service quote and invoice with calculation breakdowns",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "refNo": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 32 },
        "validity": { "type": "string", "maxLength": 64 },
        "terms": { "type": "string", "maxLength": 2048 },
        "subtotal": { "type": "number" },
        "vat": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["id", "refNo", "customerName", "total"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Registered company technician and specialist staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "specialties": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["id", "name", "role", "phone"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Registered application user profile with username, email, password credentials, and real-time presence",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "password": { "type": "string", "maxLength": 128 },
        "passwordUpdatedAt": { "type": "string", "maxLength": 64 },
        "accountEnabled": { "type": "boolean" },
        "role": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "accessLevel": { "type": "string", "enum": ["Admin", "Technician", "Engineer", "Manager"] },
        "status": { "type": "string", "enum": ["Online", "Busy", "Offline"] },
        "lastActive": { "type": "string", "maxLength": 64 },
        "currentActivity": { "type": "string", "maxLength": 256 },
        "themeMode": { "type": "string", "enum": ["Light", "Dark", "System"] }
      },
      "required": ["id", "name", "email", "role", "accessLevel", "status"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Real-time user operation and system audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 256 },
        "details": { "type": "string", "maxLength": 1024 },
        "type": { "type": "string", "enum": ["auth", "repair", "project", "cors", "quote", "profile", "system"] },
        "userEmail": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "timestamp", "action", "type"]
    },
    "InternalNote": {
      "title": "InternalNote",
      "description": "Technician internal note on a repair order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "repairId": { "type": "string", "maxLength": 128 },
        "author": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "text": { "type": "string", "maxLength": 2048 }
      },
      "required": ["id", "repairId", "author", "text"]
    }
  },
  "firestore": {
    "/repairs/{repairId}": {
      "schema": "Repair",
      "description": "Equipment repair orders"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Surveying and mapping projects"
    },
    "/cors_stations/{stationId}": {
      "schema": "CORSStation",
      "description": "CORS geodetic reference stations"
    },
    "/equipment/{equipmentId}": {
      "schema": "Equipment",
      "description": "District surveying equipment records"
    },
    "/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Service and repair quotations"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Registered technicians and engineering personnel"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Registered system users with real-time presence and profile data"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Real-time system and user activity logs"
    },
    "/internal_notes/{noteId}": {
      "schema": "InternalNote",
      "description": "Internal technician notes for repair work orders"
    }
  }
}
